    "                    ax1.set_title('RA (narrow)', fontsize=14, x=0.4)\n",
    "                else:\n",
    "                    ax1.set_title(f'{key}', fontsize=14, x=0.4)\n",
    "\n",
    "                # Add asterisk specific to RA\n",
    "                if key == 'RAV':\n",
    "                    target_date = pd.to_datetime('2025-02-05')\n",
